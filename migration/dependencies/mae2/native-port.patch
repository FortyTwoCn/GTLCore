@@ -0,0 +1,47 @@
+/* MAE2 native capability bridge, LGPL-3.0-or-later. */
+package stone.mae2.parts.p2p;
+
+import appeng.api.networking.crafting.ICraftingProvider;
+import appeng.helpers.patternprovider.PatternProviderLogicHost;
+import appeng.api.parts.IPartHost;
+import appeng.api.parts.RegisterPartCapabilitiesEvent;
+import net.minecraft.core.Direction;
+import net.neoforged.neoforge.capabilities.BlockCapability;
+import net.neoforged.neoforge.capabilities.Capabilities;
+import com.gregtechceu.gtceu.api.capability.GTCapability;
+import stone.mae2.parts.p2p.multi.*;
+
+public final class NativePartCapabilities {
+    private NativePartCapabilities() {}
+
+    public static <T> T forwardPatternCapability(PatternP2PTunnelLogic.Target target,
+                                                 BlockCapability<T, Direction> capability) {
+        var entity = target.getTargetBlockEntity();
+        boolean provider = entity instanceof ICraftingProvider || entity instanceof PatternProviderLogicHost;
+        if (entity instanceof IPartHost host) {
+            var part = host.getPart(target.side());
+            provider |= part instanceof ICraftingProvider || part instanceof PatternProviderLogicHost;
+        }
+        return provider ? target.level().getCapability(capability, target.pos(), target.side()) : null;
+    }
+
+    public static void register(RegisterPartCapabilitiesEvent event) {
+        event.register(Capabilities.ItemHandler.BLOCK, (part, context) -> part.getCapability(Capabilities.ItemHandler.BLOCK), ItemMultiP2PTunnel.Part.class);
+        event.register(Capabilities.FluidHandler.BLOCK, (part, context) -> part.getCapability(Capabilities.FluidHandler.BLOCK), FluidMultiP2PTunnel.Part.class);
+        event.register(Capabilities.EnergyStorage.BLOCK, (part, context) -> part.getCapability(Capabilities.EnergyStorage.BLOCK), FEMultiP2PTunnel.Part.class);
+        if (net.neoforged.fml.ModList.get().isLoaded("gtceu")) {
+            event.register(GTCapability.CAPABILITY_ENERGY_CONTAINER, (part, context) -> part.getExposedApi(), EUP2PTunnelPart.class);
+            event.register(GTCapability.CAPABILITY_ENERGY_CONTAINER, (part, context) -> part.getCapability(GTCapability.CAPABILITY_ENERGY_CONTAINER), EUMultiP2PTunnel.Part.class);
+        }
+        for (var capability : BlockCapability.getAll()) {
+            if (capability.contextClass() == Direction.class) registerPattern(event, capability);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> void registerPattern(RegisterPartCapabilitiesEvent event, BlockCapability<T, ?> capability) {
+        var sided = (BlockCapability<T, Direction>) capability;
+        event.register(sided, (part, context) -> part.getCapability(sided), PatternP2PTunnelPart.class);
+        event.register(sided, (part, context) -> part.getCapability(sided), PatternMultiP2PTunnel.Part.class);
+    }
+}
diff --git a/src/main/java/stone/mae2/parts/p2p/NativePatternTargetCache.java b/src/main/java/stone/mae2/parts/p2p/NativePatternTargetCache.java
