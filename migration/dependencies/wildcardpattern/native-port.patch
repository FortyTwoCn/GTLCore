+package org.leodreamer.wildcard_pattern.gui;
+
+import com.lowdragmc.lowdraglib.gui.widget.TextFieldWidget;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/** Native text packets with exact long arithmetic; LDLib's generic numeric wheel/drag uses float. */
+public final class WildcardLongAmountField extends TextFieldWidget {
+    public WildcardLongAmountField(int x, int y, int width, int height, Supplier<String> source, Consumer<String> change) {
+        super(x, y, width, height, source, change);
+        setNumbersOnly(1L, Long.MAX_VALUE);
+        setMaxStringLength(19);
+    }
+    @Override public boolean mouseWheelMove(double x, double y, double horizontal, double vertical) {
+        if (!isMouseOverElement(x, y) || !isFocus() || vertical == 0) return false;
+        long value = Long.parseLong(getCurrentString());
+        if (vertical > 0) { if (value < Long.MAX_VALUE) value++; }
+        else if (value > 1) value--;
+        onTextChanged(Long.toString(value));
+        return true;
+    }
+    @Override public boolean mouseDragged(double x, double y, int button, double deltaX, double deltaY) {
+        // Numeric dragging in the library parses through float and can change an untouched large amount.
+        return false;
+    }
+}
