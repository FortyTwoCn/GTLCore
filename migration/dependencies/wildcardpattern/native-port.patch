+/** The original preview, input, output and three filter editors with native tabs and inventory slots. */
+public final class WildcardEditorWidget extends WidgetGroup {
+    private final WildcardUIFactory.Holder holder;
+    public WildcardEditorWidget(WildcardPatternLogic logic, Player player, WildcardUIFactory.Holder holder) {
+        super(0, 0, 198, 234);
+        this.holder = holder;
+        addWidget(new LabelWidget(9, 5, Component.translatable("sftcore.item.wildcard_pattern.config").getString()));
+        var tabs = new TabContainer(8, 20, 182, 128);
+        var preview = new WildcardIndexPage(holder::currentStack, player.level(), 0, 0, 158, 80);
+        var input = new WildcardIOFancyConfigurator(logic, WildcardPatternLogic.IO.IN, stack -> holder.markAsDirty());
+        var output = new WildcardIOFancyConfigurator(logic, WildcardPatternLogic.IO.OUT, stack -> holder.markAsDirty());
+        var filter = new WildcardFilterFancyConfigurator(logic, stack -> holder.markAsDirty());
+        addTab(tabs, 0, new com.lowdragmc.lowdraglib.gui.texture.ItemStackTexture(WildcardItems.WILDCARD_PATTERN.get()), preview, "preview");
+        addTab(tabs, 1, input.getTabIcon(), (WidgetGroup) input.createMainPage(this), "input");
+        addTab(tabs, 2, output.getTabIcon(), (WidgetGroup) output.createMainPage(this), "output");
+        addTab(tabs, 3, filter.getTabIcon(), (WidgetGroup) filter.createMainPage(this), "filter");
+        addWidget(tabs);
+        for (int row = 0; row < 3; row++) for (int column = 0; column < 9; column++)
+            addWidget(new SlotWidget(player.getInventory(), 9 + row * 9 + column, 18 + 18 * column, 154 + 18 * row, true, true)
+                    .setBackground(WildcardGuiTextures.SLOT));
+        for (int column = 0; column < 9; column++)
+            addWidget(new SlotWidget(player.getInventory(), column, 18 + 18 * column, 212, true, true)
+                    .setBackground(WildcardGuiTextures.SLOT));
+    }
+    public boolean isValidEditingItem() { return !holder.isInvalid(); }
+    private void addTab(TabContainer tabs, int index, com.lowdragmc.lowdraglib.gui.texture.IGuiTexture icon,
+                        WidgetGroup contents, String name) {
+        contents.setSelfPosition(com.lowdragmc.lowdraglib.math.Position.of(22, 0));
+        contents.setId("wildcard_" + name);
+        var button = new TabButton(0, index * 25, 20, 23).setBaseTexture(ResourceBorderTexture.BUTTON_COMMON, icon)
+                .setPressedTexture(ResourceBorderTexture.BUTTON_COMMON.copy().setColor(0xFF80BFFF), icon);
+        button.setId("wildcard_tab_" + name);
+        tabs.addTab(button, contents);
+    }
+}
