+package net.celsiusqc.ad_astra_rocketed.neoforge;
+
+import net.celsiusqc.ad_astra_rocketed.common.tags.AdAstraRocketed;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.IEventBus;
+import net.neoforged.fml.common.Mod;
+import net.neoforged.fml.loading.FMLEnvironment;
+
+@Mod(AdAstraRocketed.MOD_ID)
+public final class AdAstraRocketedNeoForge {
+    public AdAstraRocketedNeoForge(IEventBus bus) {
+        AdAstraRocketed.init();
+        if (FMLEnvironment.dist == Dist.CLIENT) {
+            bus.addListener(net.celsiusqc.ad_astra_rocketed.client.AdAstraRocketedClient::registerRenderers);
+            bus.addListener(net.celsiusqc.ad_astra_rocketed.client.AdAstraRocketedClient::registerLayers);
+            bus.addListener(net.celsiusqc.ad_astra_rocketed.client.AdAstraRocketedClient::registerItemRenderers);
+        }
+    }
+}
