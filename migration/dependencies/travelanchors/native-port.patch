@@ -0,0 +1,27 @@
+package de.castcrafter.travelanchors.mixin;
+
+import de.castcrafter.travelanchors.ModEnchantments;
+import de.castcrafter.travelanchors.ModItems;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.network.chat.contents.TranslatableContents;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.enchantment.Enchantment;
+import net.minecraft.world.item.enchantment.ItemEnchantments;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/** Range keeps its original prerequisite on tools; data-driven primary items handle enchanting-table availability. */
+@Mixin(Enchantment.class)
+public abstract class RangeEnchantmentMixin {
+    @Inject(method = "canEnchant", at = @At("RETURN"), cancellable = true, require = 1)
+    private void travelanchors$requireTeleportation(ItemStack stack, CallbackInfoReturnable<Boolean> cir) {
+        var enchantment = (Enchantment) (Object) this;
+        if (!cir.getReturnValue() || !(enchantment.description().getContents() instanceof TranslatableContents text) ||
+                !text.getKey().equals("enchantment.travelanchors.range")) return;
+        boolean teleportable = stack.getOrDefault(DataComponents.ENCHANTMENTS, ItemEnchantments.EMPTY).entrySet().stream()
+                .anyMatch(entry -> entry.getKey().is(ModEnchantments.teleportation) && entry.getIntValue() > 0);
+        cir.setReturnValue(stack.is(ModItems.travelStaff) || teleportable);
+    }
+}
